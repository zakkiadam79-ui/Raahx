# PHP API administrator credential. Never commit the real value.
ADMIN_SECRET=replace-with-a-long-random-secret
# Server-only key used to encrypt Creator CNIC values at rest (minimum 32 random characters).
CREATOR_PII_KEY=replace-with-a-separate-long-random-encryption-key

# Frontend PHP API base URL. Use /api when the PHP API is served by the same domain.
VITE_API_BASE_URL=/api

# PHP/MySQL server-only configuration.
RAAHX_DB_HOST=127.0.0.1
RAAHX_DB_PORT=3306
RAAHX_DB_NAME=replace-with-hostinger-database-name
RAAHX_DB_USER=replace-with-hostinger-database-user
RAAHX_DB_PASSWORD=
RAAHX_ALLOWED_ORIGINS=https://replace-with-raahx-domain.example
APP_URL=https://replace-with-raahx-domain.example

# Server-only Hostinger SMTP settings. Never prefix these with VITE_.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@raahx.com
SMTP_PASS=
MAIL_FROM=hello@raahx.com
MAIL_TO=hello@raahx.com
