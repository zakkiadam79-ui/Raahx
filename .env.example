# Server-only administrator credential. Never commit the real value.
ADMIN_SECRET=replace-with-a-long-random-secret

# Frontend PHP API base URL. Leave unset to use the current local fallback.
# VITE_API_BASE_URL=http://localhost:8000/api

# Server-only MongoDB connection used by proposals, blog views, and newsletter subscribers.
MONGODB_URI=

# Server-only Hostinger SMTP settings. Never prefix these with VITE_.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@raahx.com
SMTP_PASS=
MAIL_FROM=hello@raahx.com
MAIL_TO=hello@raahx.com
