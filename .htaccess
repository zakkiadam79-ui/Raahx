Options -MultiViews

RewriteEngine On

# Consolidate HTTP and www requests on the preferred HTTPS hostname.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.raahx\.com(?::\d+)?$ [NC]
RewriteRule ^ https://raahx.com%{REQUEST_URI} [R=301,L,NE]

# Send HSTS only on HTTPS responses. Do not use preload here.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# Cache Vite's content-hashed static assets for one year. API/PHP responses
# and index.html are intentionally excluded from this rule.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\\.(?:css|js|mjs|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Revalidate the SPA entry point so deployments never strand visitors on stale
# asset hashes. This does not affect hashed assets or API/PHP responses.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# Leave all API requests to api/.htaccess and api/index.php.
RewriteRule ^api(?:/|$) - [L]

# Serve Creator profile HTML through the lightweight metadata renderer so
# social crawlers receive the Creator name, bio, image, and canonical URL.
# Join/edit routes do not match this creator-* pattern.
RewriteRule ^creator-network/(creator-[A-Za-z0-9-]+)/?$ creator-profile.php?creator=$1 [L,QSA]

# Serve existing files and directories normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send all other paths to the React/Vite SPA entry point.
RewriteRule ^ index.html [L]
